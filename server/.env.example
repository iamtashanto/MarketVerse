# Pooled connection (PgBouncer, transaction mode) — used by the app's PrismaClient at runtime.
DATABASE_URL="postgresql://user:password@pgbouncer-host:6432/marketverse?schema=public&pgbouncer=true"

# Direct, unpooled connection — used only by Prisma Migrate (DDL needs session-level features).
DIRECT_DATABASE_URL="postgresql://user:password@primary-host:5432/marketverse?schema=public"
