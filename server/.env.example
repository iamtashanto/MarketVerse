# --- Database (see docs/DATABASE_DESIGN.md §11.1) ---
# Pooled connection (PgBouncer, transaction mode) — used by the app's PrismaClient at runtime.
DATABASE_URL="postgresql://user:password@pgbouncer-host:6432/marketverse?schema=public&pgbouncer=true"
# Direct, unpooled connection — used only by Prisma Migrate (DDL needs session-level features).
DIRECT_DATABASE_URL="postgresql://user:password@primary-host:5432/marketverse?schema=public"

# --- App ---
NODE_ENV="development"
PORT="4000"
LOG_LEVEL="debug"
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# --- Redis (see docs/BACKEND_ARCHITECTURE.md §12) ---
REDIS_URL="redis://localhost:6379/0"

# --- Auth (see docs/BACKEND_ARCHITECTURE.md §9) ---
JWT_ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL_DAYS="30"

# --- Object storage (see docs/BACKEND_ARCHITECTURE.md §19) ---
S3_BUCKET="marketverse-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CDN_BASE_URL="https://cdn.marketverse.example"
