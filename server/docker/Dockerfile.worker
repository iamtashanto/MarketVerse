# Same build, different runtime command — deployed as a separate service/task
# from the web image so the worker tier scales independently of the web tier.
# See docs/BACKEND_ARCHITECTURE.md §21.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup -S marketverse && adduser -S marketverse -G marketverse

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

USER marketverse
CMD ["node", "dist/jobs/worker.js"]
